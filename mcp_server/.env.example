# Copy to .env and fill in. .env is git-ignored; the secret below is a live credential.
#
# Generate the key pair on the site itself:
#   bench --site <site> mcp-bridge-keys --user mcp@example.com --show-env

# --- Target site -------------------------------------------------------------
# No trailing slash.
FRAPPE_MCP_URL=https://erp.example.com
FRAPPE_MCP_API_KEY=
FRAPPE_MCP_API_SECRET=

# --- Connection --------------------------------------------------------------
FRAPPE_MCP_TIMEOUT=120
# Set to false only for a self-signed certificate on a site you control.
FRAPPE_MCP_VERIFY_SSL=true

# --- Behaviour ---------------------------------------------------------------
# Shown in every MCP Bridge Log row, so you can tell one client's calls from another's.
FRAPPE_MCP_CLIENT_NAME=claude-code

# Refuse every writing tool in this client, whatever the site allows. A second lock
# on top of Read Only Mode in MCP Bridge Settings.
FRAPPE_MCP_READ_ONLY=true

# true forces every write to a dry run, false forces a real write, blank leaves the
# decision to Default To Dry Run in MCP Bridge Settings.
FRAPPE_MCP_DRY_RUN=

# --- Transport ---------------------------------------------------------------
# stdio for Claude Code and Claude Desktop, streamable-http to expose it over the
# network for a claude.ai custom connector.
FRAPPE_MCP_TRANSPORT=stdio
FRAPPE_MCP_HOST=127.0.0.1
FRAPPE_MCP_PORT=8765

# --- Local diagnostics -------------------------------------------------------
# The audit trail lives on the site in MCP Bridge Log. This file only helps when a
# call never gets that far.
FRAPPE_MCP_LOG_LEVEL=INFO
FRAPPE_MCP_LOG_FILE=
