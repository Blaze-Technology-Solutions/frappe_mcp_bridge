  {
   "fieldname": "artifacts_section",
   "fieldtype": "Section Break",
   "label": "Artifacts"
  },
  {
   "fieldname": "allow_artifacts",
   "fieldtype": "Check",
   "label": "Allow Artifacts",
   "default": "1",
